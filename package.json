{
  "name": "simplemud",
  "version": "1.0.0",
  "description": "SimpleMUD from MUD Game Programming book ported to NodeJS",
  "main": "./src/server.js",
  "type": "commonjs",
  "scripts": {
    "test": "./node_modules/.bin/mocha --reporter spec",
    "start": "DEBUG=* nodemon ./src/app.js --legacy-watch  --watch ./src --polling-interval 2000",
    "lint": "eslint . --ext .js",
    "format": "eslint . --ext .js --fix"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/lnguyenfx/simplemud.git"
  },
  "keywords": [
    "simplemudjs",
    "simplemud",
    "nodejs",
    "mud",
    "server"
  ],
  "author": "Long Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lnguyenfx/simplemud/issues"
  },
  "homepage": "https://github.com/lnguyenfx/simplemud#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "debug": "^4.4.0",
    "eventemitter3": "^5.0.1",
    "fuzzysort": "^3.1.0",
    "htmlparser2": "^4.1.0",
    "insort": "^0.4.0",
    "jsonfile": "^3.0.0",
    "lodash": "^4.17.21",
    "node-rsa": "^1.1.1",
    "string-width": "^2.1.1",
    "tree": "^0.1.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "chai": "^4.0.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "mocha": "^11.1.0",
    "prettier": "^3.5.3",
    "sinon": "^2.3.2"
  }
}
