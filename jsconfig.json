{
  "compilerOptions": {
    "checkJs": true,
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "downlevelIteration": true,
  },
  "include": ["**/*.js"]
}